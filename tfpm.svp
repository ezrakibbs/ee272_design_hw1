// A simple test bench for the fpm 12 bit floating point multiplier
`timescale 1ns/10ps

module top();
    typedef struct packed {
        reg Sign;
        reg [4:0] Exp;
        reg [5:0] Fract;
    } FP;
    typedef struct packed {
        FP A,B;
        FP Z;
    } FPS;
    reg clk,reset;
    reg pushin,pushout;
    FP A,B;
    FP Z;
    FPS eres[$];

